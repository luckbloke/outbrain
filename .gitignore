# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 运行时数据（SQLite / WAL / 备份 / 上传 / TLS 证书）----
# 数据库和用户数据只在本机，不进版本库；`data/` 会在启动时自动创建。
data/

# ---- 日志 / 临时文件 / 本地备份 ----
*.log
*.bak
*.backup
*.tmp
*.temp
*.swp
*.swo
~$*
.DS_Store
Thumbs.db
desktop.ini

# ---- 本机构建时下载的 Python 源码包 ----
Python-*.tar.xz
Python-*.tgz

# ---- Android 构建时生成的兜底 CA（源文件是 certs/cacert.pem）----
brain/ca_data.py

# ---- Android 构建产物（源码与配置仍入库）----
android/dist/
android/bin/
android/build/
android/.buildozer/
android/.gradle/
android/buildozer.log
*.apk
*.aab

# ---- Windows 桌面端打包产物 ----
desktop/build/
desktop/dist/
desktop/*.exe

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.iml
*.code-workspace

# ---- 本地密钥 / 环境变量（不要把 API key 提交上来）----
.env
.env.*
config.local.toml
